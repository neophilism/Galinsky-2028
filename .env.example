# Local examples contain no credentials. Production uses only assigned infrastructure.
NODE_ENV=development
HOST=127.0.0.1
PORT=4322
PUBLIC_ORIGIN=http://localhost:4321
PORTAL_ORIGIN=http://localhost:4322
# Configure the assigned Neon project; require verified TLS. Never commit this value.
DATABASE_URL=
MAIL_PROVIDER=disabled
RESEND_API_KEY=
MAIL_FROM=
# A base64-encoded random 32-byte key, exclusively for server-processed delivery metadata.
# Not E2EE, not a volunteer private-recipient key. Keep versions for pending deliveries.
DELIVERY_KEY=
LOGIN_PEPPER=
SIGNUP_ENABLED=false
# Staff and protected-content releases are deliberately unavailable in v0.1.
STAFF_IDENTITY_ENABLED=false
PROTECTED_CONTENT_ENABLED=false
DONATIONS_ENABLED=false
# Three to four separate, independently approved hosted checkout routes; no default provider.
# Any campaign donations require signed treasurer approval, valid processor contracts,
# independently tested settlement routes, and release controls.
DONATIONS_TREASURER_APPROVED=false
DONATIONS_PRIMARY_PROCESSOR_ID=
DONATIONS_PROCESSOR_1_APPROVED=false
DONATIONS_PROCESSOR_1_ID=
DONATIONS_PROCESSOR_1_NAME=
DONATIONS_PROCESSOR_1_HOST=
DONATIONS_PROCESSOR_1_URL=
DONATIONS_PROCESSOR_2_APPROVED=false
DONATIONS_PROCESSOR_2_ID=
DONATIONS_PROCESSOR_2_NAME=
DONATIONS_PROCESSOR_2_HOST=
DONATIONS_PROCESSOR_2_URL=
DONATIONS_PROCESSOR_3_APPROVED=false
DONATIONS_PROCESSOR_3_ID=
DONATIONS_PROCESSOR_3_NAME=
DONATIONS_PROCESSOR_3_HOST=
DONATIONS_PROCESSOR_3_URL=
DONATIONS_PROCESSOR_4_APPROVED=false
DONATIONS_PROCESSOR_4_ID=
DONATIONS_PROCESSOR_4_NAME=
DONATIONS_PROCESSOR_4_HOST=
DONATIONS_PROCESSOR_4_URL=
