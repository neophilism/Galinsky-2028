# Local examples contain no credentials. Production uses only assigned infrastructure.
NODE_ENV=development
HOST=127.0.0.1
PORT=4322
PUBLIC_ORIGIN=http://localhost:4321
PORTAL_ORIGIN=http://localhost:4322
# Configure the assigned Neon project; require verified TLS. Never commit this value.
DATABASE_URL=
MAIL_PROVIDER=disabled
# Mail delivery is OFF by default. Production signup requires a real
# operationally accepted worker on this service or a separately run worker.
# "inline" uses the EXISTING portal service (no additional Render service).
# "external" requires an independently maintained active mail worker.
MAIL_DELIVERY_MODE=disabled
MAIL_WORKER_OPERATIONAL_APPROVED=false
RESEND_API_KEY=
MAIL_FROM=
# A base64-encoded random 32-byte key, exclusively for server-processed delivery metadata.
# Not E2EE, not a volunteer private-recipient key. Keep versions for pending deliveries.
DELIVERY_KEY=
LOGIN_PEPPER=
SIGNUP_ENABLED=false
# Private, invitation-only treasury console. Public volunteer signup stays OFF.
# Owner email is bound by HMAC; never hardcode a name or email in source.
# Enable only AFTER migration 009 and verified email worker + keys are in place.
G28_ADMIN_LOGIN_ENABLED=false
G28_OWNER_ADMIN_EMAIL=
# Random 32-byte base64 AES-256-GCM key stored on the existing protected portal service.
# Loss of this key means previously encrypted vault records cannot be read.
G28_TREASURY_VAULT_KEY=
# Private policy source reader token is on the existing WEB preview service,
# with Contents: Read on the THREE source repositories only.
G28_POLICY_READ_TOKEN=

# Staff and protected-content releases are deliberately unavailable in v0.1.
STAFF_IDENTITY_ENABLED=false
PROTECTED_CONTENT_ENABLED=false
DONATIONS_ENABLED=false
# 1-16 separately approved processors; native Stripe may be the first.
# The web service also needs its approved DATABASE_URL and migration 007 before activation.
# These flags represent actual written underwriting and signed treasurer acceptance,
# not local demo readiness; each provider health record must be activated separately.
DONATIONS_TREASURER_APPROVED=false
DONATIONS_PROCESSOR_1_APPROVED=false
DONATIONS_PROCESSOR_1_ID=
DONATIONS_PROCESSOR_1_NAME=
DONATIONS_PROCESSOR_1_HOST=
DONATIONS_PROCESSOR_1_URL=
DONATIONS_PROCESSOR_2_APPROVED=false
DONATIONS_PROCESSOR_2_ID=
DONATIONS_PROCESSOR_2_NAME=
DONATIONS_PROCESSOR_2_HOST=
DONATIONS_PROCESSOR_2_URL=
DONATIONS_PROCESSOR_3_APPROVED=false
DONATIONS_PROCESSOR_3_ID=
DONATIONS_PROCESSOR_3_NAME=
DONATIONS_PROCESSOR_3_HOST=
DONATIONS_PROCESSOR_3_URL=
DONATIONS_PROCESSOR_4_APPROVED=false
DONATIONS_PROCESSOR_4_ID=
DONATIONS_PROCESSOR_4_NAME=
DONATIONS_PROCESSOR_4_HOST=
DONATIONS_PROCESSOR_4_URL=

# STRIPE: keep all OFF until the owner enters TEST credentials in existing Render WEB service.
# Do not send keys through chat or commit them.
G28_STRIPE_TEST_ENABLED=false
# One-shot test-only preflight: checks Stripe API, creates/EXPIRES a $1 test session,
# then waits for the signed expiration webhook in the restricted staging ledger.
# Disable immediately after the passing test (does not send real money).
G28_STRIPE_SMOKE_ON_BOOT=false
# Read-only one-time inventory of Stripe TEST webhook endpoint, subscriptions and expiry event.
G28_STRIPE_DIAGNOSE_WEBHOOKS_ON_BOOT=false
G28_STRIPE_LIVE_APPROVED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
G28_STRIPE_RETURN_ORIGIN=
G28_STRIPE_COMMITTEE_NAME=Phillip Galinsky for America
# Limit values are INTEGER CENTS and MUST reflect the current approved 2028 FEC limits;
# sandbox may omit and defaults to a TEST-ONLY $100 per attempt.
G28_STRIPE_PRIMARY_LIMIT_CENTS=
G28_STRIPE_GENERAL_LIMIT_CENTS=
# LIVE ONLY: protected JSON values with dated evidence references; not credentials.
G28_STRIPE_RELEASE_JSON=
G28_STRIPE_POLICY_EVIDENCE_JSON=

# Separate, owner-managed private website reviewers; never campaign staff.
G28_REVIEW_ACCOUNTS_ENABLED=false
G28_REVIEW_DATABASE_URL=
G28_REVIEW_AUTH_SECRET=
G28_REVIEW_ORIGIN=https://galinsky-2028-private-preview.onrender.com
G28_REVIEW_SETUP_KEY=
# One deployment only: redacted live HTTPS acceptance with a disposable identity.
G28_REVIEW_LIVE_CHECK=false
G28_REVIEW_PORTAL_ORIGIN=https://galinsky-2028-volunteer-portal.onrender.com
