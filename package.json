{
  "name": "galinsky-2028",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build:public && npm run build:portal",
    "build:public": "astro build --root apps/public",
    "build:portal": "vite build --config apps/portal/vite.config.ts",
    "dev": "astro dev --root apps/public --host 127.0.0.1",
    "dev:api": "tsx watch apps/api/src/start.ts",
    "start": "tsx apps/api/src/start.ts",
    "check": "tsc --noEmit && astro check --root apps/public",
    "test": "tsx --test packages/contracts/test/*.test.ts apps/api/test/*.test.ts",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.1.2",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@fontsource-variable/inter": "5.3.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "astro": "7.3.8",
    "fastify": "5.12.5",
    "markdown-it": "15.0.2",
    "nodemailer": "10.0.16",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.18.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
