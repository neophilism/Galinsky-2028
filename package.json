{
  "name": "galinsky-2028",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "scripts": {
    "dev": "node scripts/preview.mjs",
    "dev:api": "node apps/api/src/server.mjs",
    "build": "npm run build:web && npm run build:portal",
    "build:web": "astro build --root apps/web && node scripts/build-indexing.mjs",
    "preview:serve": "node apps/web/private-preview.mjs",
    "build:portal": "vite build --config apps/portal/vite.config.ts",
    "build:offline": "node scripts/build-public.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:api": "node --test tests/integration/*.test.mjs",
    "check": "node scripts/validate.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "worker": "node apps/api/src/worker.mjs",
    "start": "node apps/api/src/server.mjs",
    "prs:refresh": "node scripts/refresh-pr-snapshot.mjs",
    "materials:publish": "node scripts/publish-materials.mjs",
    "materials:verify": "node scripts/verify-material-release.mjs",
    "materials:sign": "node scripts/sign-material-review.mjs",
    "issue:prepare": "node scripts/prepare-issue-video.mjs",
    "policy:html": "node scripts/prepare-public-document.mjs",
    "test:browser": "node tests/browser/journeys.mjs"
  },
  "dependencies": {
    "astro": "7.3.8",
    "fastify": "5.12.5",
    "pg": "8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/node": "22.18.6",
    "playwright": "1.63.0"
  }
}
