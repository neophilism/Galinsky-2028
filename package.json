{
  "name": "galinsky-2028",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "npm run build:public && npm run build:portal",
    "build:public": "astro build --root apps/public",
    "build:portal": "vite build --config apps/portal/vite.config.ts",
    "dev": "astro dev --root apps/public --host 127.0.0.1",
    "dev:api": "tsx watch apps/api/src/start.ts",
    "start": "tsx apps/api/src/start.ts",
    "check": "tsc --noEmit && astro check --root apps/public",
    "test": "tsx --test packages/contracts/test/*.test.ts apps/api/test/*.test.ts",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm test && npm run build"
  }
}
